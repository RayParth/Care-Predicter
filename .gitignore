# ══════════════════════════════════════════════════════
#  Care Predicter — .gitignore
#  Place this file at the ROOT of the project
# ══════════════════════════════════════════════════════

# ── NEVER commit these ───────────────────────────────
.env
.env.*
*.env
backend/.env
backend/.env.*
secrets.json
firebase_credentials.json
google-services-secret.json

# ── Python / FastAPI backend ─────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
backend/.venv/
venv/
.venv/
env/
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.log

# ── Flutter / Dart ────────────────────────────────────
# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# Flutter/Dart/Pub
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication
app.*.symbols

# Obfuscation
app.*.map.json

# Android build artifacts
/android/app/debug
/android/app/profile
/android/app/release

# ── Firebase ──────────────────────────────────────────
# Keep google-services.json ONLY if your repo is private
# and the file has no sensitive keys beyond the project ID.
# If public repo — add it here:
# android/app/google-services.json

# ── OS files ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────
.vscode/
*.swp
*.swo

# ── ngrok ────────────────────────────────────────────
*.ngrok.yml
ngrok.log