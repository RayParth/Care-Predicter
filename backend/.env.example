# =============================================================================
# Care Predicter backend - environment variables
#
# LOCAL:       cp .env.example .env   and fill the values
# PRODUCTION:  do NOT upload a .env file. Put each variable in your host's
#              "Variables" tab (Railway / Render). .env is git-ignored on purpose.
# Every value below is a FAKE PLACEHOLDER.
# =============================================================================

# ----- App ---------------------------------------------------------------
# "development" -> /docs is enabled, Firebase check is optional
# "production"  -> /docs hidden, server REFUSES to start with weak/missing config
ENV=development

# ----- Database (REQUIRED) -----------------------------------------------
# Local:      postgresql://postgres:YOUR_PASSWORD@localhost:5432/care_predicter
# Neon:       console.neon.tech -> your project -> Connect -> copy the connection
#             string. It ends with ?sslmode=require - keep that part.
# Railway:    add a PostgreSQL service, then reference its variable:
#             DATABASE_URL=${{Postgres.DATABASE_URL}}
# (a "postgres://" prefix is auto-fixed to "postgresql://")
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/care_predicter

# ----- JWT signing key (REQUIRED, 32+ chars in production) -----------------
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs every user out. Never reuse the one from your old .env.
SECRET_KEY=replace-with-48-random-characters-from-the-command-above

# ----- Firebase (REQUIRED in production) ---------------------------------
# Project id = "project_id" inside android/app/google-services.json.
# (Firebase console -> Project settings -> General -> Project ID)
FIREBASE_PROJECT_ID=carepredicter
# true  -> /auth/google-login and /auth/register need a valid Firebase ID token
#          (this is what stops "log in as anyone who's email I know").
# false -> LOCAL TESTING ONLY. Production refuses to boot with false.
REQUIRE_FIREBASE_TOKEN=false

# ----- Gemini (chat + lab OCR) -------------------------------------------
# Key: https://aistudio.google.com/apikey  -> "Create API key"
# NEVER put it in the Flutter app or commit it. Rotate any key that was ever
# sent over WhatsApp/zip/git history.
GEMINI_API_KEY=AIza_placeholder_not_a_real_key
# gemini-2.5-flash is scheduled to shut down 16 Oct 2026 - do not use it.
# Open AI Studio -> model list and pick a CURRENT Flash model your key can call.
GEMINI_MODEL=gemini-3.5-flash
# Tried in order if the primary returns 404/NOT_FOUND (model retired).
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=60
# Per-user cost/abuse limits for /ai/chat
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_DAY=150

# ----- Email OTP via Gmail SMTP (needed for password reset / OTP) ----------
# 1) Turn on 2-Step Verification on the Gmail account
# 2) https://myaccount.google.com/apppasswords -> create an App password
# 3) Use that 16-character value below (NOT your normal Gmail password)
SMTP_EMAIL=yourproject@gmail.com
SMTP_PASSWORD=abcdefghijklmnop

# ----- CORS --------------------------------------------------------------
# The Android app does not use CORS. Your React web interface DOES: put its
# exact origin(s) here, comma-separated, no trailing slash, e.g.
#   CORS_ORIGINS=https://care-predicter-web.vercel.app,http://localhost:5173
# Empty = every browser client is blocked (never use "*").
CORS_ORIGINS=

# ----- Twilio SMS (OPTIONAL - leave empty, feature not enabled) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
